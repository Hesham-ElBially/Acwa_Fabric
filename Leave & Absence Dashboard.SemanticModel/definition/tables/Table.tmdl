table Table
	lineageTag: aa1e13d3-d462-4f34-91fb-42a30be08db3

	measure 'Background Color' =
			
			var sv_tda = SELECTEDVALUE('TDA'[TDA])
			var sv_tap = SELECTEDVALUE('TAP'[TAP])
			var multi = sv_tap*sv_tda
			return
			SWITCH(
			    TRUE(),
			    and(sv_tap<=30, sv_tda <=1),"Green",
			    and(sv_tap<=12, sv_tda <=2),"Green",and(sv_tap<=5, sv_tda <=3),"Green", and(sv_tap<=20, sv_tda >=5),"Red",and(sv_tap>=7, sv_tda >=4),"Red",and(sv_tap>=12, sv_tda >=3),"Red","Yellow"
			    )
		lineageTag: 435a6dbf-fc82-4e3f-9b51-ac6708706081

	measure 'Font Color' = if([BFS]=0,[Background Color])
		lineageTag: 4cca363e-13e1-4eb4-a8fe-6cd7693ee8ba

	measure BFS = (SUM('TDA'[TDA])*SUM('TDA'[TDA]))* (SUM('TAP'[TAP]))
		formatString: 0
		lineageTag: 4080e341-969a-44b1-961b-72eb3c50314b

	measure 'BF Heat Map' = IF( OR('Table'[BFS]='public employee_absences'[Bradford Factor 2021],'Table'[BFS]='public employee_absences'[Bradford Factor 2022]),1,0 )
		formatString: 0
		lineageTag: e4844099-694f-4208-b253-8cb5f6ab3741

