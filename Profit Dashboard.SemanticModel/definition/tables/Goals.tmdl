	column 'Approved goals (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('Goals'[Approved goals]),
				"(Blank)",
				'Goals'[Approved goals] IN {"0",
					"1",
					"2",
					"3"},
				"0_3",
				'Goals'[Approved goals] IN {"10",
					"11",
					"12"},
				"10_12",
				'Goals'[Approved goals] IN {"13",
					"14",
					"15"},
				"13_15",
				'Goals'[Approved goals] IN {"16",
					"17",
					"18"},
				"16_18",
				'Goals'[Approved goals] IN {"19",
					"20",
					"21"},
				"19_21",
				'Goals'[Approved goals] IN {"22",
					"23",
					"24"},
				"22_24",
				'Goals'[Approved goals] IN {"25",
					"28",
					"29"},
				"25_29",
				'Goals'[Approved goals] IN {"4",
					"5",
					"6"},
				"4_6",
				'Goals'[Approved goals] IN {"7",
					"8",
					"9"},
				"7_9",
				'Goals'[Approved goals]
			)
		isHidden
		lineageTag: edbd82fa-4c8c-4fc1-99e3-3b2e48d55b35
		summarizeBy: none

