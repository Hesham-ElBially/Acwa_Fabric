	measure Completed_goals = COUNTROWS(FILTER(Goals,VALUE(Goals[# of Goals]) <> 0 && (VALUE(Goals[# of Goals])- VALUE(Goals[Completed])) = 0 ))/COUNTROWS(Goals)
