					"23"},
				"Associates",
				'v_g_JobPersonal'[payGrade] IN {"M1",
					"M2",
					"M3"},
				"Middle Mgt",
				'v_g_JobPersonal'[payGrade] IN {"L10",
					"L11",
					"L12",
					"L13",
					"L15",
					"L3",
					"L4",
					"L5",
					"L6",
					"L7",
					"L8",
					"L9",
					"PGM"},
				"Old",
				'v_g_JobPersonal'[payGrade] IN {"E1",
					"E2",
					"E3",
					"E4",
					"E5",
					"E6"},
				"Senior Mgt",
				'v_g_JobPersonal'[payGrade]
			)
		lineageTag: db4d2d47-393f-4638-98a7-346f641a0fdb
		summarizeBy: none

