	column 'payGrade (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('v_g_JobPersonal'[payGrade]),
				"(Blank)",
				'v_g_JobPersonal'[payGrade] IN {"01",
					"03",
					"05",
					"06",
					"08",
					"09",
					"10",
					"11",
