			Var	Leavers_Dec = CALCULATE(SUM('gdm f_employees_per_month'[leavers_ytd]), 'gdm f_employees_per_month'[month_short] = "Dec")
			
			Var Headcount_Jan=CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Jan")
			Var Headcount_Feb = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Feb")
			Var Headcount_Mar = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Mar")
			Var Headcount_Apr = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Apr")
			Var Headcount_May = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "May")
			Var Headcount_Jun = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Jun")
			Var Headcount_Jul = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Jul")
			Var Headcount_Aug = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Aug")
			Var Headcount_Sep = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Sep")
			Var Headcount_Oct = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Oct")
			Var Headcount_Nov = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Nov")
			Var Headcount_Dec = CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Dec")
			
			
			Var	Joiners_Jan = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Jan")+Yearstart
			Var	Joiners_Feb = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Feb")+Joiners_Jan
			Var	Joiners_Mar = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Mar")+Joiners_Feb
			Var Joiners_Apr = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Apr") + Joiners_Mar
			Var Joiners_May = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "May") + Joiners_Apr
			Var Joiners_Jun = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Jun") + Joiners_May
			Var Joiners_Jul = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Jul") + Joiners_Jun
			Var Joiners_Aug = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Aug") + Joiners_Jul
			Var Joiners_Sep = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Sep") + Joiners_Aug
			Var Joiners_Oct = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Oct") + Joiners_Sep
			Var Joiners_Nov = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Nov") + Joiners_Oct
			Var Joiners_Dec = CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Dec") + Joiners_Nov
			
			
			
			return
			switch(
			    SELECTEDVALUE('Walk'[Walksort]),
			    0,
			    IF(
			        ISBLANK(Headcount_Jan),
			        BLANK(),
			        switch(
			            SELECTEDVALUE(PVM[PVM]),
			            "Leavers", 0,
			            "Joiners", Yearstart,
