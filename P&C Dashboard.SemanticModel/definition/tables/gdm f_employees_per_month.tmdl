	measure voluntary_attrition_2_% = ```
			
			Var max_month=max('gdm f_employees_per_month'[month])
			Var min_month=calculate(min('gdm f_employees_per_month'[month]),all('gdm f_employees_per_month'[month_short]))
			
			Var a=calculate(sum('gdm f_employees_per_month'[leavers_ytd]),'gdm f_employees_per_month'[month]=max_month,'gdm f_employees_per_month'[vol_unvol_flag]="Voluntary")
			Var b1=calculate(sum('gdm f_employees_per_month'[headcount]),'gdm f_employees_per_month'[month]=max_month)
			Var b2=calculate(sum('gdm f_employees_per_month'[headcount]),'gdm f_employees_per_month'[month]=min_month,all('gdm f_employees_per_month'[month_short]))
			Var b=(b1+b2)/2
			
			VAR division_result = DIVIDE(a, b)
			VAR formatted_result = FORMAT(division_result, "0.00%")
			RETURN 
			    IF(
			        a = 0 || ISBLANK(division_result) || division_result = 0,
			        "0 (0.00%)",
			        a & " (" & formatted_result & ")"
			    )
			```
