	measure 'PVM bridge' = ```
			
			
			Var Yearstart=-CALCULATE(SUM('gdm f_employees_per_month'[joiners_mm]), 'gdm f_employees_per_month'[month_short] = "Jan")+CALCULATE(SUM('gdm f_employees_per_month'[leavers_mm]), 'gdm f_employees_per_month'[month_short] = "Jan")+CALCULATE(SUM('gdm f_employees_per_month'[headcount]), 'gdm f_employees_per_month'[month_short] = "Jan")
			
			Var	Leavers_Jan = CALCULATE(SUM('gdm f_employees_per_month'[leavers_mm]), 'gdm f_employees_per_month'[month_short] = "Jan")
			Var	Leavers_Feb = CALCULATE(SUM('gdm f_employees_per_month'[leavers_ytd]), 'gdm f_employees_per_month'[month_short] = "Feb")
