			Var a=format(a1,"#,##")
			Var b1=calculate(sum('gdm f_employees_per_month'[headcount]),'gdm d_employees_new'[corp_prj_flag]="Corporate",'gdm f_employees_per_month'[month]=max_month)
			Var b=format(b1,"#,##")
			Var c=format(divide(a,b),"0.00%")
