	measure H-perform_vol_leavers_ytd_1_% = ```
			
			VAR a = CALCULATE([Leavers_ytd_maxmonth], 'gdm f_employees_per_month'[high_performer_flag] = TRUE(), 'gdm f_employees_per_month'[vol_unvol_flag] = "Voluntary")
			VAR b = calculate(DISTINCTCOUNT('gdm w_hr_performance'[person_number]),    ALL('gdm f_employees_per_month'))
			VAR division_result = DIVIDE(a, b)
			VAR formatted_result = FORMAT(division_result, "0.00%")
