table 'gdm d_employees_new'
	lineageTag: 42be9a21-c09f-468b-880d-26fc70ed9118

	measure nationalisation_% = ```
			
			Var a=calculate([Corp_headcount_ytd_maxmonth],'gdm f_employees_per_month'[nationalisation]=1)
			Var b=[Corp_headcount_ytd_maxmonth]
			return 
			if( b<>0,a/b,0)
			
			```
		formatString: 0%;-0%;0%
		lineageTag: 291c52d8-8df8-4b59-818a-834065a2f402

	measure saudisation% =
			
			Var a=calculate([Headcount_ytd_maxmonth],value('gdm f_employees_per_month'[saudisation])=-1,'gdm f_employees_per_month'[Exclude_saudisation]=1)
			Var b=calculate([Headcount_ytd_maxmonth],'gdm f_employees_per_month'[Exclude_saudisation]=1)
			Return if(b<>0 && a<>0,a/b,0)
		lineageTag: 8a2aed0c-a833-4680-a007-3cfd2f3d0093

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_age = ```
			
			Var b=CALCULATE(AVERAGE('gdm d_employees_new'[age]),'gdm d_employees_new'[age]>1,'gdm f_employees_per_month'[headcount]=1)
			Var a=format(b,"#,0.0") & if(AVERAGE('gdm d_employees_new'[age])>0, " years","")
			return 
			if(b>0,a,"N/A")
			```
		lineageTag: 94801005-baee-4545-b496-f8ab7f7e2be4

	measure Flag_saudization = ```
			
			 Var a=[saudization1]
			return if(a>0.7,UNICHAR(10004),If(a<>0,UNICHAR(10007)," "))
			```
		lineageTag: b7b9d7b8-25d2-463e-8316-298256ec45fc

	measure saudization1 =
			
			Var a=sum('gdm d_employees_new'[saudisation_integer])/count('gdm d_employees_new'[saudisation_integer])
			return if(a<>0,a,0)
		lineageTag: 70a497bb-8a1e-4e95-8535-1f03d869b9a6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Flag_vol_attrition =
			
			Var a=[voluntary_attrition_%]
			return if(a<0.08,UNICHAR(10004),UNICHAR(10007))
		lineageTag: d806ccf7-a440-42aa-9253-607fed5dcb98

	measure Flag_saudization_text = ```
			
			 Var a=[saudisation%]
			return if(a>=0.7," Above 70%",If(a<0.7,"Below 70%"," "))
			```
		lineageTag: 02806320-bb53-4011-8598-ea6f004867c8

	measure Flag_vol_attrition_text =
			
			Var a=[voluntary_attrition_%]
			return if(a<0.08,"Below 8%","Above 8%")
		lineageTag: 2641b06c-f740-41af-a49c-06e99ce2be2c

	measure nationalisation_1% =
			
			Var max_month=max('gdm f_employees_per_month'[month])
			Var a=calculate(sum('gdm f_employees_per_month'[headcount]),'gdm f_employees_per_month'[month]=max_month,'gdm f_employees_per_month'[nationalisation]=1)
			Var b=[Headcount_ytd_maxmonth]
			return if(b<>0 && a<>0,a/b,0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 347309ec-4ee5-4baa-8368-1cbced94d6be

	measure saudisation_1% =
			
			Var a=calculate([Headcount_ytd_maxmonth],'gdm f_employees_per_month'[nationality]="Saudi Arabia",'gdm f_employees_per_month'[Exclude_saudisation]=1)
			Var b=calculate([Headcount_ytd_maxmonth],'gdm f_employees_per_month'[Exclude_saudisation]=1)
			Return if(b<>0 && a<>0,a/b,0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 404ee758-d59e-4c19-880e-ab934db289ee

