	measure 'N  rate' =
			
			var max_date= max('public employees_per_month'[date])
			var nat = calculate(distinctcount('public employees_per_month'[person_number]), 'public employees_per_month'[date] = max_date, 'public employees_per_month'[end_month]=1, 'public employees_per_month'[nationalisation]= TRUE)
			var exp = calculate(distinctcount('public employees_per_month'[person_number]), 'public employees_per_month'[date] = max_date, 'public employees_per_month'[end_month]=1, 'public employees_per_month'[nationalisation]= false)
