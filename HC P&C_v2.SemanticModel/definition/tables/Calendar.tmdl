table Calendar
	lineageTag: 4676865e-193e-493b-9d79-afdcca69da95

	measure Measure = ```
			
			VAR EndDatePervisual= MAX('Calendar'[Date])
			VAR Result= 
			CALCULATE(
			    [HC All],
			    REMOVEFILTERS('Calendar'),
			    'Employee List Including Inactive'[Date of Joining] <= EndDatePervisual,
			    'Employee List Including Inactive'[Employment Details Termination Date] > EndDatePervisual
			    ||
			    ISBLANK('Employee List Including Inactive'[Employment Details Termination Date])
			)
			RETURN
			EndDatePervisual
			```
		formatString: General Date
		lineageTag: 622cbbd7-93f2-4b74-a8df-4bbeb90a0b4d

	column Date
		formatString: General Date
		lineageTag: da302139-af49-473b-b4a1-ee49bde10d45
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variation
			isDefault
			relationship: 14410409-2913-473d-999d-7455ef7e3530
			defaultHierarchy: LocalDateTable_a644a5b1-3578-4b98-a9da-3d7ee6c12225.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: ab6ab06c-3c75-4207-bd4b-d6ffe3a7cf69
