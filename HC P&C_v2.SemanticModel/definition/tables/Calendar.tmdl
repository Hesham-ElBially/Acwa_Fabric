		annotation SummarizationSetBy = Automatic

	column 'Year Month Number'
		formatString: 0
		lineageTag: 9b222f9f-4fbc-43b4-8661-c1d2e3c3116b
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year Month Number]

		annotation SummarizationSetBy = Automatic

	column 'Year Month'
		lineageTag: 030f7414-e989-466d-b0d8-d6b3d00d8ecc
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]

		annotation SummarizationSetBy = Automatic

	column 'Week Number'
		formatString: 0
