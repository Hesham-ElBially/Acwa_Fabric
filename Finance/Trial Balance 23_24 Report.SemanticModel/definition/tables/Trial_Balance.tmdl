table Trial_Balance
	lineageTag: 3be66581-0662-49c1-85d2-30ffbd9531bc

	/// Calculates the sum of the opening balances from the Trial_Balance table.
	measure Total_Opening_Balance =
			
			IF(
			    ISBLANK(SUM(Trial_Balance[Opening_Balance])),
			    0,
			    SUM(Trial_Balance[Opening_Balance])
			)
		lineageTag: 73a17dac-8376-442c-b691-8a8de50ffe03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the total opening balance in Saudi Riyal (SAR) by summing the values in the Opening_Balance_SAR column of the Trial_Balance table.
	measure Total_Opening_Balance_SAR = SUM(Trial_Balance[Opening_Balance_SAR])
		lineageTag: 0cdfad44-f2ed-4eb4-9359-8001864b757f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the sum of the closing balances from the Trial Balance table.
	measure Total_Closing_Balance =
			
			IF(
			    ISBLANK(SUM(Trial_Balance[Closing_Balance])),
			    0,
			    SUM(Trial_Balance[Closing_Balance])
			)
		lineageTag: e650344e-b16c-402d-9461-dfb96502630c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the total closing balance in Saudi Riyal (SAR) by summing the values in the Closing_Balance_SAR column of the Trial_Balance table.
	measure Total_Closing_Balance_SAR = SUM(Trial_Balance[Closing_Balance_SAR])
		lineageTag: ddf415b1-faa2-4f2c-a374-0a313c981f48

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the sum of the Total Credit column in the Trial Balance table.
	measure Total_Credit_Sum = SUM(Trial_Balance[Total_Credit])
		lineageTag: ca2568c8-b205-41c9-aeea-7128326834f0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the sum of the Total Debit column in the Trial Balance table.
	measure Total_Debit_Sum = SUM(Trial_Balance[Total_Debit])
		lineageTag: e0d309e2-a517-43fb-96a2-9382817ececf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Period' = MAX(Trial_Balance[Period_Name])
		formatString: General Date
		lineageTag: d4305372-6a0c-44cb-b1df-366ecf01ab00

	measure Total_Balance =
			
			IF(
			    ISBLANK(SUM(Trial_Balance[Closing_Balance])),
			    0,
			    SUM(Trial_Balance[Closing_Balance])
			)
		lineageTag: 842f38ff-5636-4d8c-93e3-f1adfd9f4cef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Change =
			
			IF(
			    ISBLANK([Total_Closing_Balance] - [Total_Opening_Balance]),
			    0,
			    [Total_Closing_Balance] - [Total_Opening_Balance]
			)
		lineageTag: d4b69f6f-5a68-4629-b39c-5bc55dc6aa6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Expense' =
			
			IF(
			    ISBLANK([Total_Closing_Balance] - [Total_Opening_Balance]),
			    0,
			    [Total_Closing_Balance] - [Total_Opening_Balance]
			)
		lineageTag: 9eeda157-c158-4707-8ce4-bb5437d15cb7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

