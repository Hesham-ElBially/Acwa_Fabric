table 'S4_Hana viw_Param2'
	lineageTag: e7ba6077-c902-4bfe-a598-05016c2690e8

	measure 'YoY % Purchase Doc Count' =
			
			VAR Prev =
			    CALCULATE (
			        DISTINCTCOUNT ( 'S4_Hana viw_Param2'[EBELN_Purchasing Doc.] ),
			        DATEADD ( 'S4_Hana viw_Param2'[Purchase Year], -1, YEAR )
			    )
			VAR Curr =
			    DISTINCTCOUNT ( 'S4_Hana viw_Param2'[EBELN_Purchasing Doc.] )
			RETURN
			DIVIDE ( Curr - Prev, Prev )
		formatString: 0
		lineageTag: da2fa19c-71db-4c35-bafc-f4a46bfe40c0

	measure 'Purchase Doc Count' =
			
			DISTINCTCOUNT ( 'S4_Hana viw_Param2'[EBELN_Purchasing Doc.] )
		formatString: 0
		lineageTag: 981fb4ca-afbc-499f-ab18-de28fb6a1a77

	measure 'Business Volume SAR' =
			
			SUM ('S4_Hana viw_Param2'[Net Value SAR])
		lineageTag: 010d1fd3-bd86-4565-8124-ac658eae7325

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Purchase Doc Count PY' =
			
			VAR CurrYear =
			    SELECTEDVALUE ( 'S4_Hana viw_Param2'[Purchase Year] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'S4_Hana viw_Param2'[EBELN_Purchasing Doc.] ),
			    FILTER (
			        ALL ( 'S4_Hana viw_Param2'[Purchase Year] ),
			        'S4_Hana viw_Param2'[Purchase Year] = CurrYear - 1
			    )
			)
		formatString: 0
		lineageTag: d9d2e154-5b82-4ad1-9c08-505d285a4936

	measure 'Business Volume SAR PY' = ```
			
			VAR CurrYear =
			    SELECTEDVALUE ( 'S4_Hana viw_Param2'[Purchase Year] )
			RETURN
			CALCULATE (
			    SUM ( 'S4_Hana viw_Param2'[Net Value SAR] ),
			    FILTER (
			        ALL ( 'S4_Hana viw_Param2'[Purchase Year] ),
			        'S4_Hana viw_Param2'[Purchase Year] = CurrYear - 1
			    )
			)
			
			```
		lineageTag: 764cc4c3-2f6b-469f-a1d8-cd316347a799

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Purchase Doc Count % Change' =
			
			VAR Curr = [Purchase Doc Count]
			VAR Prev = [Purchase Doc Count PY]
			RETURN
			IF ( ISBLANK ( Prev ), BLANK (), DIVIDE ( Curr - Prev, Prev ) )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fc58060b-ea2d-4af0-bed1-01a02a87fba6

	measure 'Business Volume SAR % Change' =
			
			VAR Curr = [Business Volume SAR]
			VAR Prev = [Business Volume SAR PY]
			RETURN
			IF ( ISBLANK ( Prev ), BLANK (), DIVIDE ( Curr - Prev, Prev ) )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d05bb8f1-2126-462a-8a4a-d63a418842a2

