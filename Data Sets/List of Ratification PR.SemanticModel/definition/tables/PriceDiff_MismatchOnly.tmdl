		sourceColumn: List_of_all_PR_PO[Company Code : Company Name]

		annotation SummarizationSetBy = Automatic

	column UNIQUEID
		lineageTag: 5b8ffa81-39dc-4c55-97ad-7320055c1465
		summarizeBy: none
		isNameInferred
		sourceColumn: List_of_all_PR_PO[UNIQUEID]

		annotation SummarizationSetBy = Automatic

	partition PriceDiff_MismatchOnly = calculated
		mode: import
		source =
				
				VAR KeysBothRoutes =
				    FILTER (
				        ADDCOLUMNS (
				            SUMMARIZE (
				                'List_of_all_PR_PO',
				                'List_of_all_PR_PO'[Plant Code : Plant Name],
				                'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				                'List_of_all_PR_PO'[Material : Short Text]
				            ),
				            "EmergencyCnt",
				                CALCULATE (
				                    COUNTROWS ( 'List_of_all_PR_PO' ),
				                    'List_of_all_PR_PO'[Requirement Urgency] = "01",
				                    NOT ISBLANK ( 'List_of_all_PR_PO'[Net Price SAR] )
				                ),
				            "RegularCnt",
				                CALCULATE (
				                    COUNTROWS ( 'List_of_all_PR_PO' ),
				                    'List_of_all_PR_PO'[Requirement Urgency] <> "01",
				                    NOT ISBLANK ( 'List_of_all_PR_PO'[Net Price SAR] )
				                )
				        ),
				        [EmergencyCnt] > 0 && [RegularCnt] > 0
				    )
				
				VAR RegularSet =
				    SUMMARIZE (
				        CALCULATETABLE (
				            'List_of_all_PR_PO',
				            'List_of_all_PR_PO'[Requirement Urgency] <> "01",
				            NOT ISBLANK ( 'List_of_all_PR_PO'[Net Price SAR] ),
				            TREATAS (
				                SELECTCOLUMNS (
				                    KeysBothRoutes,
				                    "Plant", [Plant Code : Plant Name],
				                    "Vendor", [Vendor Code : Vendor Name],
				                    "Material", [Material : Short Text]
				                ),
				                'List_of_all_PR_PO'[Plant Code : Plant Name],
				                'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				                'List_of_all_PR_PO'[Material : Short Text]
				            )
				        ),
				        'List_of_all_PR_PO'[Plant Code : Plant Name],
				        'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				        'List_of_all_PR_PO'[Material : Short Text],
				        'List_of_all_PR_PO'[Net Price SAR]
				    )
				
				VAR EmergencySet =
				    SUMMARIZE (
				        CALCULATETABLE (
				            'List_of_all_PR_PO',
				            'List_of_all_PR_PO'[Requirement Urgency] = "01",
				            NOT ISBLANK ( 'List_of_all_PR_PO'[Net Price SAR] ),
				            TREATAS (
				                SELECTCOLUMNS (
				                    KeysBothRoutes,
				                    "Plant", [Plant Code : Plant Name],
				                    "Vendor", [Vendor Code : Vendor Name],
				                    "Material", [Material : Short Text]
				                ),
				                'List_of_all_PR_PO'[Plant Code : Plant Name],
				                'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				                'List_of_all_PR_PO'[Material : Short Text]
				            )
				        ),
				        'List_of_all_PR_PO'[Plant Code : Plant Name],
				        'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				        'List_of_all_PR_PO'[Material : Short Text],
				        'List_of_all_PR_PO'[Net Price SAR]
				    )
				
				VAR MismatchKeysRaw =
				    UNION (
				        EXCEPT ( EmergencySet, RegularSet ),
				        EXCEPT ( RegularSet, EmergencySet )
				    )
				
				/* Ensure exactly 4 columns for TREATAS */
				VAR MismatchKeys =
				    SELECTCOLUMNS (
				        MismatchKeysRaw,
				        "Plant",    [Plant Code : Plant Name],
				        "Vendor",   [Vendor Code : Vendor Name],
				        "Material", [Material : Short Text],
				        "Price",    [Net Price SAR]
				    )
				RETURN
				    CALCULATETABLE (
				        'List_of_all_PR_PO',
				        TREATAS (
				            MismatchKeys,
				            'List_of_all_PR_PO'[Plant Code : Plant Name],
				            'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				            'List_of_all_PR_PO'[Material : Short Text],
				            'List_of_all_PR_PO'[Net Price SAR]
				        )
				    )

	annotation PBI_Id = 532bc13b59b64fb7bded3639c6f14147

