table A01_01
	lineageTag: 1e899528-bfe6-4f5a-8be7-9204a90084e3

	measure A01_01OverduePercentage = SUM('A01_01'[No. of Overdue Observations]) / CALCULATE(SUM('A01_01'[No. of Open Observations]), ALLSELECTED('A01_01'[Issues.Category2]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fbfa5645-53ac-4bbf-b27c-f5833208f039

	measure A01_01_KPI_B_Status = ```
			SWITCH( 
			                        TRUE,
			                        (SELECTEDVALUE(A01_01[Issues.Category2]) = "High") && ('A01_01'[A01_01OverduePercentage] >=0.05), "01. KPI B Breach",
			                        (SELECTEDVALUE(A01_01[Issues.Category2]) = "Significant") && ('A01_01'[A01_01OverduePercentage] >=0.1), "01. KPI B Breach",
			                        (SELECTEDVALUE(A01_01[Issues.Category2]) = "Medium") && ('A01_01'[A01_01OverduePercentage] >=0.1), "01. KPI B Breach",
			                        "02. KPI B Non Breach"
			)
			```
		lineageTag: 153e7524-6c33-4c26-b046-3a4ebbbb521e

	column 'Recommendations.Category1'
		lineageTag: f93f66ec-bdb2-4daa-ade2-d323c2b71248
		summarizeBy: none
		isNameInferred
		sourceColumn: A01 - Open Observation Report as of Today[Recommendations.Category1]

		annotation SummarizationSetBy = Automatic

	column 'Issues.Category2'
		lineageTag: 63fbe4de-814f-4ed7-a23f-c23e7705e253
		summarizeBy: none
		isNameInferred
		sourceColumn: A01 - Open Observation Report as of Today[Issues.Category2]
		sortByColumn: 'Rating Order'

		annotation SummarizationSetBy = Automatic

	column 'No. of Overdue Observations'
		formatString: 0
		lineageTag: 2ff34f96-7a13-4094-9bef-e2bfd77a7702
		summarizeBy: sum
		isNameInferred
		sourceColumn: [No. of Overdue Observations]

		annotation SummarizationSetBy = Automatic

	column 'No. of Non Overdue Observations'
		formatString: 0
		lineageTag: 630f3c28-2be9-4104-a3be-e317e8b45653
		summarizeBy: sum
		isNameInferred
		sourceColumn: [No. of Non Overdue Observations]

		annotation SummarizationSetBy = Automatic

	column 'No. of Open Observations'
		formatString: 0
		lineageTag: 2051375a-c5e7-4eea-853e-b7306bf65fbf
		summarizeBy: sum
		isNameInferred
		sourceColumn: [No. of Open Observations]

		annotation SummarizationSetBy = Automatic

	column 'Percentage of Overdue Observations' = A01_01[No. of Overdue Observations]/A01_01[No. of Open Observations]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8bec879b-d097-4ab8-a2a9-280c46729135
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'KPI B Status' = ```
			SWITCH( 
			                        TRUE,
			                        ('A01_01'[Issues.Category2] = "High") && ('A01_01'[Percentage of Overdue Observations] >=0.05), "01. KPI B Breach",
			                        ('A01_01'[Issues.Category2] = "Significant") && ('A01_01'[Percentage of Overdue Observations] >=0.1), "01. KPI B Breach",
			                        ('A01_01'[Issues.Category2] = "Medium") && ('A01_01'[Percentage of Overdue Observations] >=0.1), "01. KPI B Breach",
			                        "02. KPI B Non Breach"
			)
			```
		lineageTag: 2e1fc57f-a8dc-45b5-afdd-638018abd445
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Rating Order' = ```
			RELATED('A00 - Rating Order'[Order]) 
			```
		formatString: 0
		lineageTag: 62faa075-aaf2-4441-ae9b-f6a1f42063bd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition A01_01 = calculated
		mode: import
		source = ```
				SUMMARIZE('A01 - Open Observation Report as of Today',
				'A01 - Open Observation Report as of Today'[Recommendations.Category1],
				'A01 - Open Observation Report as of Today'[Issues.Category2], 
				"No. of Overdue Observations", COUNTROWS (FILTER ('A01 - Open Observation Report as of Today', 'A01 - Open Observation Report as of Today'[Final_Status] = "01. Overdue")),
				"No. of Non Overdue Observations", COUNTROWS (FILTER ('A01 - Open Observation Report as of Today', 'A01 - Open Observation Report as of Today'[Final_Status] = "02. Non-Overdue")),
				"No. of Open Observations", COUNT('A01 - Open Observation Report as of Today'[RecommendationId]))
				```

	annotation PBI_Id = abba5aebdb8a4ea7b0e2fcf412d5a911

