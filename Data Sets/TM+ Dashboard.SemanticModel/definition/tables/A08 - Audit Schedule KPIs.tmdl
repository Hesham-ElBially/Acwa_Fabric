	column 'KPI A' = IF(ISBLANK('A08 - Audit Schedule KPIs'[A08 - FieldWork Actual Start Date.ActStartDate].[Date]) && ISBLANK('A08 - Audit Schedule KPIs'[A08 - Final Report Issuance Date.A08_00 - Final Report Issuance Date.ActualEndDa].[Date]),"FieldWork Actual Start Date & Final Report Issuance Date are blank", IF(ISBLANK('A08 - Audit Schedule KPIs'[A08 - FieldWork Actual Start Date.ActStartDate].[Date]),"FieldWork Actual Start Date is blank", IF(ISBLANK('A08 - Audit Schedule KPIs'[A08 - Final Report Issuance Date.A08_00 - Final Report Issuance Date.ActualEndDa].[Date]),"Final Report Issuance Date is blank", FORMAT(1+DATEDIFF('A08 - Audit Schedule KPIs'[A08 - FieldWork Actual Start Date.ActStartDate].[Date], 'A08 - Audit Schedule KPIs'[A08 - Final Report Issuance Date.A08_00 - Final Report Issuance Date.ActualEndDa].[Date], DAY), "General Number"))))
		lineageTag: 5f659ec4-2334-45bc-a8c3-7fe2f304ea72
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'KPI B' = IF(ISBLANK('A08 - Audit Schedule KPIs'[A08 - TeamMate Updated Date.A08_00 - TeamMate Updated Date.ActualEndDate].[Date]) && ISBLANK('A08 - Audit Schedule KPIs'[A08 - Final Report Issuance Date.A08_00 - Final Report Issuance Date.ActualEndDa].[Date]),"Final Report Issuance Date & TeamMate Updated Date are blank", IF(ISBLANK('A08 - Audit Schedule KPIs'[A08 - TeamMate Updated Date.A08_00 - TeamMate Updated Date.ActualEndDate].[Date]),"TeamMate Updated Date is blank", IF(ISBLANK('A08 - Audit Schedule KPIs'[A08 - Final Report Issuance Date.A08_00 - Final Report Issuance Date.ActualEndDa].[Date]),"Final Report Issuance Date is blank", FORMAT(1+DATEDIFF('A08 - Audit Schedule KPIs'[A08 - Final Report Issuance Date.A08_00 - Final Report Issuance Date.ActualEndDa].[Date], 'A08 - Audit Schedule KPIs'[A08 - TeamMate Updated Date.A08_00 - TeamMate Updated Date.ActualEndDate].[Date], DAY), "General Number"))))
		lineageTag: 5a63ef54-d644-408e-b0c3-6b012cb7a007
		summarizeBy: none

