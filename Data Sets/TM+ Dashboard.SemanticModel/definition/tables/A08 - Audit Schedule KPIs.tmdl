	column 'Planning Indicator #1' =
			SWITCH(
			                    TRUE,
			                    NOT ISBLANK('A08 - Audit Schedule KPIs'[A08 - Planning Scheduled Start Date.ScheduledStartDate]), "Scheduled Start Date is Not Blank",
			                    ISBLANK('A08 - Audit Schedule KPIs'[A08 - Planning Scheduled Start Date.ScheduledStartDate]), "Scheduled Start Date is Blank"
			                    )
		lineageTag: 587e9782-0e7c-4cb1-ba82-a07189725122
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Planning Indicator #2' =
			SWITCH(
			                    TRUE,
			                    NOT ISBLANK('A08 - Audit Schedule KPIs'[A08 - Planning Scheduled End Date.ScheduledEndDate]), "Scheduled End Date is Not Blank",
			                    ISBLANK('A08 - Audit Schedule KPIs'[A08 - Planning Scheduled End Date.ScheduledEndDate]), "Scheduled End Date is Blank"
			                    )
		lineageTag: c4f7e5f8-d1ce-402f-b2e5-8939063b7430
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Planning Indicator #3' =
			SWITCH(
			                    TRUE,
			                    NOT ISBLANK('A08 - Audit Schedule KPIs'[A08 - Planning Actual Start Date.ActStartDate]), "Actual Start Date is Not Blank",
			                    ISBLANK('A08 - Audit Schedule KPIs'[A08 - Planning Actual Start Date.ActStartDate]), "Actual Start Date is Blank"
			                    )
		lineageTag: fd597664-f161-4b9f-8b01-290b6f7f6f4a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Planning Indicator #4' =
			SWITCH(
			                    TRUE,
			                    NOT ISBLANK('A08 - Audit Schedule KPIs'[A08 - Planning Actual End Date.ActEndDate]), "Actual End Date is Not Blank",
			                    ISBLANK('A08 - Audit Schedule KPIs'[A08 - Planning Actual End Date.ActEndDate]), "Actual End Date is Blank"
			                    )
		lineageTag: 88d54f3b-288b-4be0-923a-b018b7a412bd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Planning Indicator #5' =
			SWITCH(
			                    TRUE,
			                    NOT ISBLANK('A08 - Audit Schedule KPIs'[A08 - AAL Issuance Date.A08_00 - AAL Issuance Date.ActualEndDate]), "AAL Issuance Date is Not Blank",
			                    ISBLANK('A08 - Audit Schedule KPIs'[A08 - AAL Issuance Date.A08_00 - AAL Issuance Date.ActualEndDate]), "AAL Issuance Date is Blank"
			                    )
		lineageTag: 441ea10b-d332-4752-af33-4a6ca8cf8b9c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Planning Overall Indicator' = ```
			SWITCH(
			                    TRUE,
			                    ('A08 - Audit Schedule KPIs'[Planning Indicator #1] = "Scheduled Start Date is Blank") || ('A08 - Audit Schedule KPIs'[Planning Indicator #2] = "Scheduled End Date is Blank") || 
			                    ('A08 - Audit Schedule KPIs'[Planning Indicator #3] = "Actual Start Date is Blank") || 
			                    ('A08 - Audit Schedule KPIs'[Planning Indicator #4] = "Actual End Date is Blank") ||
								('A08 - Audit Schedule KPIs'[Planning Indicator #5] = "AAL Issuance Date is Blank"), "Red",
			                    ('A08 - Audit Schedule KPIs'[Planning Indicator #1] = "Scheduled Start Date is Not Blank") ||
			                    ('A08 - Audit Schedule KPIs'[Planning Indicator #2] = "Scheduled End Date is Not Blank") ||
			                    ('A08 - Audit Schedule KPIs'[Planning Indicator #3] = "Actual Start Date is Not Blank") ||
			                    ('A08 - Audit Schedule KPIs'[Planning Indicator #4] = "Actual End Date is Not Blank") ||
								('A08 - Audit Schedule KPIs'[Planning Indicator #5] = "AAL Issuance Date is Not Blank"),"Green")
			```
		lineageTag: 75c55085-d69b-47db-b830-b45d7a190ad1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

