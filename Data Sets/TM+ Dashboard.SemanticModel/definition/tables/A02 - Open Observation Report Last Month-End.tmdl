		annotation SummarizationSetBy = Automatic

	column Ageing = DATEDIFF('A02 - Open Observation Report Last Month-End'[Action_Due_Date__For_Ageing_].[Date], 'A02 - Open Observation Report Last Month-End'[cReportingCutOff].[Date], DAY)
		formatString: 0
		lineageTag: efb0975a-a05d-4de1-91b7-639251028ba5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Ageing_Buckets = ```
			SWITCH( 
			                        TRUE,
			                        ('A02 - Open Observation Report Last Month-End'[Final_Status] = "01. Overdue") && ('A02 - Open Observation Report Last Month-End'[Ageing] <=30), "01. Less Than or Equal to 30 days",
			                        ('A02 - Open Observation Report Last Month-End'[Final_Status] = "01. Overdue") && ('A02 - Open Observation Report Last Month-End'[Ageing] <=60), "02. Between 31 and 60 days",
			                        ('A02 - Open Observation Report Last Month-End'[Final_Status] = "01. Overdue") && ('A02 - Open Observation Report Last Month-End'[Ageing] <=90), "03. Between 61 and 90 days",
			                        ('A02 - Open Observation Report Last Month-End'[Final_Status] = "01. Overdue") && ('A02 - Open Observation Report Last Month-End'[Ageing] >= 91), "04. Over 90 days",
			                        ('A02 - Open Observation Report Last Month-End'[Final_Status] = "02. Non-Overdue") && ('A02 - Open Observation Report Last Month-End'[Ageing] >=-30), "05. This observation is going to become Overdue Less Than or Equal to 30 days",
			                        ('A02 - Open Observation Report Last Month-End'[Final_Status] = "02. Non-Overdue") && ('A02 - Open Observation Report Last Month-End'[Ageing] >=-60), "06. This observation is going to become Overdue Between 31 and 60 days",
			                        ('A02 - Open Observation Report Last Month-End'[Final_Status] = "02. Non-Overdue") && ('A02 - Open Observation Report Last Month-End'[Ageing] >=-90), "07. This observation is going to become Overdue Between 61 and 90 days",
			                        ('A02 - Open Observation Report Last Month-End'[Final_Status] = "02. Non-Overdue") && ('A02 - Open Observation Report Last Month-End'[Ageing] <= -91), "08. This observation is going to become Overdue in 90+ days",
			                        "09. Default"
			)
			```
		lineageTag: c14a814f-8cf4-49f6-b101-1071afe7b2cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Final_Status =
			SWITCH(
			                        TRUE,
			                        'A02 - Open Observation Report Last Month-End'[Ageing] > 0, "01. Overdue",
			                        'A02 - Open Observation Report Last Month-End'[Ageing] <= 0, "02. Non-Overdue",
			                        "Default")
		lineageTag: 1ef92e5f-65b5-49f0-819c-d76cd8cddb05
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'KPI A Status' =
			SWITCH(
			                    TRUE,
			                    'A02 - Open Observation Report Last Month-End'[Issues.Category2] = "High" && 'A02 - Open Observation Report Last Month-End'[Ageing] >= 31, "01. KPI A Breach",
			                    'A02 - Open Observation Report Last Month-End'[Issues.Category2] = "Significant" && 'A02 - Open Observation Report Last Month-End'[Ageing] >= 61, "01. KPI A Breach",
			                    'A02 - Open Observation Report Last Month-End'[Issues.Category2] = "Medium" && 'A02 - Open Observation Report Last Month-End'[Ageing] >= 91, "01. KPI A Breach",
			                    "02. KPI A Non-Breach")
		lineageTag: 97fd272e-640d-41ce-a314-7c7dedf4f1d1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

