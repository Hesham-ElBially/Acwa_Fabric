		annotation SummarizationSetBy = Automatic

	column Ageing = DATEDIFF('A01 - Open Observation Report as of Today'[Action_Due_Date__For_Ageing_].[Date], 'A01 - Open Observation Report as of Today'[cReportingCutOff].[Date], DAY)
		formatString: 0
		lineageTag: 7e63aaea-9fec-4b21-917a-fe13f80099a6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Final_Status =
			SWITCH(
			                        TRUE,
			                        'A01 - Open Observation Report as of Today'[Ageing] > 0, "01. Overdue",
			                        'A01 - Open Observation Report as of Today'[Ageing] <= 0, "02. Non-Overdue",
			                        "Default")
		lineageTag: 22bbe8b4-ac72-42a0-940b-08e37a3f08f6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ageing_Buckets = ```
			SWITCH( 
			                        TRUE,
			                        ('A01 - Open Observation Report as of Today'[Final_Status] = "01. Overdue") && ('A01 - Open Observation Report as of Today'[Ageing] <=30), "01. Less Than or Equal to 30 days",
			                        ('A01 - Open Observation Report as of Today'[Final_Status] = "01.Overdue") && ('A01 - Open Observation Report as of Today'[Ageing] <=60), "02. Between 31 and 60 days",
			                        ('A01 - Open Observation Report as of Today'[Final_Status] = "01. Overdue") && ('A01 - Open Observation Report as of Today'[Ageing] <=90), "03. Between 61 and 90 days",
			                        ('A01 - Open Observation Report as of Today'[Final_Status] = "01. Overdue") && ('A01 - Open Observation Report as of Today'[Ageing] >= 91), "04. Over 91 days",
			                        ('A01 - Open Observation Report as of Today'[Final_Status] = "02. Non-Overdue") && ('A01 - Open Observation Report as of Today'[Ageing] >=-30), "05. This observation is going to become Overdue Less Than or Equal to 30 days",
			                        ('A01 - Open Observation Report as of Today'[Final_Status] = "02. Non-Overdue") && ('A01 - Open Observation Report as of Today'[Ageing] >=-60), "06. This observation is going to become Overdue Between 31 and 60 days",
			                        ('A01 - Open Observation Report as of Today'[Final_Status] = "02. Non-Overdue") && ('A01 - Open Observation Report as of Today'[Ageing] >=-90), "07. This observation is going to become Overdue Between 61 and 90 days",
			                        ('A01 - Open Observation Report as of Today'[Final_Status] = "02. Non-Overdue") && ('A01 - Open Observation Report as of Today'[Ageing] <= -91), "08. This observation is going to become Overdue in 90+ days",
			                        "09. Default"
			)
			```
		lineageTag: ba7e6d73-e88b-4ca2-b2be-45cb52c64690
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'KPI A Status' =
			SWITCH(
			                    TRUE,
			                    'A01 - Open Observation Report as of Today'[Issues.Category2] = "High" && 'A01 - Open Observation Report as of Today'[Ageing] >= 31, "01. KPI A Breach",
			                    'A01 - Open Observation Report as of Today'[Issues.Category2] = "Significant" && 'A01 - Open Observation Report as of Today'[Ageing] >= 61, "01. KPI A Breach",
			                    'A01 - Open Observation Report as of Today'[Issues.Category2] = "Medium" && 'A01 - Open Observation Report as of Today'[Ageing] >= 91, "01. KPI A Breach",
			                    "02. KPI A Non-Breach")
		lineageTag: eb46399f-6c17-4273-8343-2d1e09897da8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

