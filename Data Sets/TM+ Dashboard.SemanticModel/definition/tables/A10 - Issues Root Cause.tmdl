table 'A10 - Issues Root Cause'
	lineageTag: 669b61a9-ca57-4bdf-8de1-775bc2937d66

	measure FilterFlag =
			
			VAR _tbl =
			    FILTER(
			        ADDCOLUMNS(
			            GENERATE(
			                VALUES( 'A10 - Issues Root Cause'[Issues.MultiSelectCategory3]),
			                VALUES( A10_01[@RootCauseCategory] )
			            ),
			            "Flag",
			                IF(
			                    CONTAINSSTRING( 'A10 - Issues Root Cause'[Issues.MultiSelectCategory3], A10_01[@RootCauseCategory] ),
			                    1,
			                    0
			                )
			        ),
			        [Flag] = 1
			    )
			RETURN
			    IF( COUNTROWS( _tbl ), 1, 0 )
		formatString: 0
		lineageTag: 753d358d-17d0-4418-a496-8da879a55e81

