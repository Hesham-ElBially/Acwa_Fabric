	column Action_Due_Date__For_Ageing_Jan = ```
			if('A10 - Issues Root Cause'[Recommendations.RevisedDueDate]>'A10 - Issues Root Cause'[Recommendations.DueDate], 'A10 - Issues Root Cause'[Recommendations.RevisedDueDate], 'A10 - Issues Root Cause'[Recommendations.DueDate]) 
			```
		formatString: General Date
		lineageTag: 2c3d1c8b-da8e-4ea1-b98c-f5d774f6d588
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 8501ff30-c5de-490b-8aa5-7236c6dfa6b1
			defaultHierarchy: LocalDateTable_ba85e282-b5b6-4593-9791-92938f39c3d6.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Ageing = DATEDIFF('A10 - Issues Root Cause'[Action_Due_Date__For_Ageing_Jan].[Date], 'A10 - Issues Root Cause'[cJanReportingCutOff].[Date], DAY)
		formatString: 0
		lineageTag: b9c06c58-64f4-4aae-971a-b93e43bfcc89
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Final_Status_Jan =
			SWITCH(
			                        TRUE,
			                        'A10 - Issues Root Cause'[Ageing] > 0, "01. Overdue",
			                        'A10 - Issues Root Cause'[Ageing] <= 0, "02. Non-Overdue",
			                        "Default")
		lineageTag: 75a62b71-3a6f-463e-b429-91b747974ffd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'KPI A Status Jan' =
			SWITCH(
			                    TRUE,
			                    'A10 - Issues Root Cause'[Issues.Category2] = "High" && 'A10 - Issues Root Cause'[Ageing] >= 31, "01. KPI A Breach",
			                    'A10 - Issues Root Cause'[Issues.Category2] = "Significant" && 'A10 - Issues Root Cause'[Ageing] >= 61, "01. KPI A Breach",
			                    'A10 - Issues Root Cause'[Issues.Category2] = "Medium" && 'A10 - Issues Root Cause'[Ageing] >= 91, "01. KPI A Breach",
			                    "02. KPI A Non-Breach")
		lineageTag: d2de9913-e8fe-40a7-bb42-fbfcccaca8a8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

