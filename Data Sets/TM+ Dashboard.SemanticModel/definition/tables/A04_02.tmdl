		annotation SummarizationSetBy = Automatic

	column 'KPI B Status' = ```
			SWITCH( 
			                        TRUE,
			                        ('A04_02'[Issues.Category2] = "High") && ('A04_02'[Percentage of Overdue Observations] >=0.05), "01. KPI B Breach",
			                        ('A04_02'[Issues.Category2] = "Significant") && ('A04_02'[Percentage of Overdue Observations] >=0.1), "01. KPI B Breach",
			                        ('A04_02'[Issues.Category2] = "Medium") && ('A04_02'[Percentage of Overdue Observations] >=0.1), "01. KPI B Breach",
			                        "02. KPI B Non Breach"
			)
			```
		lineageTag: b0b114f5-9311-4e67-865a-e6ad18e8a2d9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Rating Order' = RELATED('A00 - Rating Order'[Order])
		formatString: 0
		lineageTag: 1adf7e3c-809b-44a2-8790-cbd2c771a0e3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition A04_02 = calculated
		mode: import
		source = ```
				SUMMARIZE('A04 - Open Observation Report Current Month-End',
				'A04 - Open Observation Report Current Month-End'[Issues.Category2], 
				"No. of Overdue Observations", COUNTROWS (FILTER ('A04 - Open Observation Report Current Month-End', 'A04 - Open Observation Report Current Month-End'[Final_Status] = "01. Overdue")),
				"No. of Non Overdue Observations", COUNTROWS (FILTER ('A04 - Open Observation Report Current Month-End', 'A04 - Open Observation Report Current Month-End'[Final_Status] = "02. Non-Overdue")),
				"No. of Open Observations", COUNT('A04 - Open Observation Report Current Month-End'[RecommendationId]))
				```

	annotation PBI_Id = f34b203c545e4035b7ae7f98fa09c967

