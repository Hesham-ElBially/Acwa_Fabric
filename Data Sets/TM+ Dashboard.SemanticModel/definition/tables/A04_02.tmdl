	column 'Percentage of Overdue Observations' = A04_02[No. of Overdue Observations]/A04_02[No. of Open Observations]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 67f291ef-92a6-4d3b-a9b0-c5af7879143f
