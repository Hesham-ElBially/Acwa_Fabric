	column 'Total Available Hrs' = 'A05 - OverallTimesheetReport'[Total Project Hrs]+'A05 - OverallTimesheetReport'[Total Admin Hrs (Chargeable)]+'A05 - OverallTimesheetReport'[Total Admin Hrs (Non - Chargeable)]
		lineageTag: 5d1290ba-c045-4b49-8099-bbaf9fbc63ce
