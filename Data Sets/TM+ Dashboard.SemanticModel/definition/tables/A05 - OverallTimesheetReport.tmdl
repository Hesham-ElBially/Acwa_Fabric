	column 'Total Chargeable Hrs' = 'A05 - OverallTimesheetReport'[Total Project Hrs]+ 'A05 - OverallTimesheetReport'[Total Admin Hrs (Chargeable)]
		lineageTag: 73c5bf69-04ba-4f5a-b569-dd064dea0cc7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

