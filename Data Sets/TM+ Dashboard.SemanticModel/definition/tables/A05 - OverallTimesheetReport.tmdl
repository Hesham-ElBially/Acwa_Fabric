	column Utilization = ```
			'A05 - OverallTimesheetReport'[Total Chargeable Hrs]/'A05 - OverallTimesheetReport'[Total Available Hrs] 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c15958cd-2f0b-4cf8-8083-e9d2d3fe696f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column EmployeeType =
			SWITCH(TRUE,
									('A05 - OverallTimesheetReport'[TimeEntryUserId] = 939) || ('A05 - OverallTimesheetReport'[TimeEntryUserId] = 981) || ('A05 - OverallTimesheetReport'[TimeEntryUserId] = 16) || ('A05 - OverallTimesheetReport'[TimeEntryUserId] = 19) || ('A05 - OverallTimesheetReport'[TimeEntryUserId] = 10) || ('A05 - OverallTimesheetReport'[TimeEntryUserId] = 15), "Portfolio Lead",
									"Lead Auditor"
			)
		lineageTag: 6aa01ed4-5307-4452-91a3-f917624696d0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Target =
			SWITCH(TRUE,
									('A05 - OverallTimesheetReport'[EmployeeType] = "Portfolio Lead") && ('A05 - OverallTimesheetReport'[Utilization] < 0.75), "Under Utilization",
			                        ('A05 - OverallTimesheetReport'[EmployeeType] = "Portfolio Lead") && ('A05 - OverallTimesheetReport'[Utilization] = 0.75), "At Par Utilization",
			                        ('A05 - OverallTimesheetReport'[EmployeeType] = "Portfolio Lead") && ('A05 - OverallTimesheetReport'[Utilization] > 0.75), "Over Utilization",
			                        ('A05 - OverallTimesheetReport'[EmployeeType] = "Lead Auditor") && ('A05 - OverallTimesheetReport'[Utilization] < 0.80), "Under Utilization",
			                        ('A05 - OverallTimesheetReport'[EmployeeType] = "Lead Auditor") && ('A05 - OverallTimesheetReport'[Utilization] = 0.80), "At Par Utilization",
			                        ('A05 - OverallTimesheetReport'[EmployeeType] = "Lead Auditor") && ('A05 - OverallTimesheetReport'[Utilization] > 0.80), "Over Utilization",
									"Default"
			)
		lineageTag: 2fd19acd-9751-44f0-ab57-90946b7e8122
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cTarget = SELECTEDVALUE('A05 - OverallTimesheetReport'[Target])
		lineageTag: 8306bd75-6cd7-4805-83ec-e5feeaf4a5b9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

