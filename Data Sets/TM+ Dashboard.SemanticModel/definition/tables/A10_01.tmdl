	column @RootCauseCategory
		lineageTag: 77e9e5bd-6cb1-483f-82c2-44a51f904728
		summarizeBy: none
		isNameInferred
		sourceColumn: [@RootCauseCategory]

		annotation SummarizationSetBy = Automatic

	column 'Root Cause Label' = TRIM(PATHITEM(SUBSTITUTE(A10_01[@RootCauseCategory], ":", "|"), 1))
		lineageTag: 705f00f4-5457-4a29-83e7-762b457a2dcd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Root Cause Sub Category' = TRIM(PATHITEM(SUBSTITUTE(A10_01[@RootCauseCategory], ":", "|"), 2))
		lineageTag: fd04acf4-c741-4c06-9c90-c07388622df2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Root Cause' = ```
			SWITCH( 
			                        TRUE,
			                        ('A10_01'[Root Cause Label] = "SYS"), "System",
			                        ('A10_01'[Root Cause Label] = "MGT"), "Management",
			                        ('A10_01'[Root Cause Label] = "GOV"), "Governance",
			                        ('A10_01'[Root Cause Label] = "PPL"), "People",
			                        ('A10_01'[Root Cause Label] = "PRO"), "Process",
			                        ('A10_01'[Root Cause Label] = "JDG"), "Judgement",
			                        "Default"
			)
			```
		lineageTag: 769758d2-f64f-4576-9a11-1364458716a3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition A10_01 = calculated
		mode: import
		source =
				DISTINCT(FILTER(SELECTCOLUMNS(UNION(
				ADDCOLUMNS(
				VALUES('A10 - Issues Root Cause'[Issues.MultiSelectCategory3]),"RootCauseCategory", PATHITEM( SUBSTITUTE('A10 - Issues Root Cause'[Issues.MultiSelectCategory3],",","|"),1)),
				ADDCOLUMNS(
				VALUES('A10 - Issues Root Cause'[Issues.MultiSelectCategory3]),"RootCauseCategory", PATHITEM( SUBSTITUTE('A10 - Issues Root Cause'[Issues.MultiSelectCategory3],",","|"),2))),"@RootCauseCategory",[RootCauseCategory]),[@RootCauseCategory]<>BLANK()))

	annotation PBI_Id = 74fc9152e1854bd8b57969bf77f9e66b

