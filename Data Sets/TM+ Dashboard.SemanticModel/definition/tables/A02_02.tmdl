	column 'Percentage of Overdue Observations' = A02_02[No. of Overdue Observations]/A02_02[No. of Open Observations]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: acbca0d9-12ba-43a3-9bb8-6ba5fe444475
