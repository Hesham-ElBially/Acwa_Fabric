		annotation SummarizationSetBy = Automatic

	column 'KPI B Status' = ```
			SWITCH( 
			                        TRUE,
			                        ('A02_02'[Issues.Category2] = "High") && ('A02_02'[Percentage of Overdue Observations] >=0.05), "01. KPI B Breach",
			                        ('A02_02'[Issues.Category2] = "Significant") && ('A02_02'[Percentage of Overdue Observations] >=0.1), "01. KPI B Breach",
			                        ('A02_02'[Issues.Category2] = "Medium") && ('A02_02'[Percentage of Overdue Observations] >=0.1), "01. KPI B Breach",
			                        "02. KPI B Non Breach"
			)
			```
		lineageTag: fd31d622-9af4-47e4-b5c7-bc6cfa80377e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Rating Order' = RELATED('A00 - Rating Order'[Order])
		formatString: 0
		lineageTag: aa687f62-d410-4996-b6fd-2a656ef1ee80
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition A02_02 = calculated
		mode: import
		source = ```
				SUMMARIZE('A02 - Open Observation Report Last Month-End',
				'A02 - Open Observation Report Last Month-End'[Issues.Category2], 
				"No. of Overdue Observations", COUNTROWS (FILTER ('A02 - Open Observation Report Last Month-End', 'A02 - Open Observation Report Last Month-End'[Final_Status] = "01. Overdue")),
				"No. of Non Overdue Observations", COUNTROWS (FILTER ('A02 - Open Observation Report Last Month-End', 'A02 - Open Observation Report Last Month-End'[Final_Status] = "02. Non-Overdue")),
				"No. of Open Observations", COUNT('A02 - Open Observation Report Last Month-End'[RecommendationId]))
				```

	annotation PBI_Id = fa5ed7dfc6024b2597297de0ab798d49

