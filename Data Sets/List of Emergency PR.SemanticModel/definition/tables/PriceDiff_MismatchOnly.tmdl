	column UNIQUEID
		lineageTag: 35479bc2-34cf-488d-9bf2-5363ce3e1a07
		summarizeBy: none
		isNameInferred
		sourceColumn: List_of_all_PR_PO[UNIQUEID]

		annotation SummarizationSetBy = Automatic

	partition PriceDiff_MismatchOnly = calculated
		mode: import
		source =
				
				VAR GroupsBothRoutes =
				    FILTER (
				        ADDCOLUMNS (
				            SUMMARIZE (
				                'List_of_all_PR_PO',
				                'List_of_all_PR_PO'[Plant Code : Plant Name],
				                'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				                'List_of_all_PR_PO'[Material : Short Text]
				            ),
				            "HasEmergency",
				                CALCULATE (
				                    COUNTROWS ( 'List_of_all_PR_PO' ),
				                    'List_of_all_PR_PO'[Requirement Urgency] = "01",
				                    NOT ISBLANK ( 'List_of_all_PR_PO'[Net Price SAR] )
				                ),
				            "HasRegular",
				                CALCULATE (
				                    COUNTROWS ( 'List_of_all_PR_PO' ),
				                    'List_of_all_PR_PO'[Requirement Urgency] <> "01",
				                    NOT ISBLANK ( 'List_of_all_PR_PO'[Net Price SAR] )
				                )
				        ),
				        [HasEmergency] > 0 && [HasRegular] > 0
				    )
				
				VAR GroupFilter =
				    TREATAS (
				        SELECTCOLUMNS (
				            GroupsBothRoutes,
				            "Plant",    [Plant Code : Plant Name],
				            "Vendor",   [Vendor Code : Vendor Name],
				            "Material", [Material : Short Text]
				        ),
				        'List_of_all_PR_PO'[Plant Code : Plant Name],
				        'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				        'List_of_all_PR_PO'[Material : Short Text]
				    )
				
				/* Distinct (Plant, Vendor, Material, Price) signatures */
				VAR EmergencySig =
				    SUMMARIZE (
				        CALCULATETABLE (
				            'List_of_all_PR_PO',
				            GroupFilter,
				            'List_of_all_PR_PO'[Requirement Urgency] = "01",
				            NOT ISBLANK ( 'List_of_all_PR_PO'[Net Price SAR] )
				        ),
				        'List_of_all_PR_PO'[Plant Code : Plant Name],
				        'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				        'List_of_all_PR_PO'[Material : Short Text],
				        'List_of_all_PR_PO'[Net Price SAR]
				    )
				
				VAR RegularSig =
				    SUMMARIZE (
				        CALCULATETABLE (
				            'List_of_all_PR_PO',
				            GroupFilter,
				            'List_of_all_PR_PO'[Requirement Urgency] <> "01",
				            NOT ISBLANK ( 'List_of_all_PR_PO'[Net Price SAR] )
				        ),
				        'List_of_all_PR_PO'[Plant Code : Plant Name],
				        'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				        'List_of_all_PR_PO'[Material : Short Text],
				        'List_of_all_PR_PO'[Net Price SAR]
				    )
				
				/* A) Matching prices (same price exists in both routes) */
				VAR MatchSig =
				    INTERSECT ( EmergencySig, RegularSig )
				
				/* B) Mismatching prices (present in one route but not the other) */
				VAR MismatchSig =
				    UNION (
				        EXCEPT ( EmergencySig, RegularSig ),
				        EXCEPT ( RegularSig, EmergencySig )
				    )
				
				/* 1) All EMERGENCY rows where price matches regular price */
				VAR MatchingEmergencyRows =
				    CALCULATETABLE (
				        'List_of_all_PR_PO',
				        'List_of_all_PR_PO'[Requirement Urgency] = "01",
				        TREATAS (
				            MatchSig,
				            'List_of_all_PR_PO'[Plant Code : Plant Name],
				            'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				            'List_of_all_PR_PO'[Material : Short Text],
				            'List_of_all_PR_PO'[Net Price SAR]
				        )
				    )
				
				/* 2) All mismatch rows (BOTH Emergency + Regular) at differing prices */
				VAR MismatchRows =
				    CALCULATETABLE (
				        'List_of_all_PR_PO',
				        TREATAS (
				            MismatchSig,
				            'List_of_all_PR_PO'[Plant Code : Plant Name],
				            'List_of_all_PR_PO'[Vendor Code : Vendor Name],
				            'List_of_all_PR_PO'[Material : Short Text],
				            'List_of_all_PR_PO'[Net Price SAR]
				        )
				    )
				
				RETURN
				    DISTINCT ( UNION ( MatchingEmergencyRows, MismatchRows ) )

	annotation PBI_Id = 532bc13b59b64fb7bded3639c6f14147

