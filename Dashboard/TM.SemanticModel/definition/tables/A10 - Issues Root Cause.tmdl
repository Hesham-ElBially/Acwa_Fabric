table 'A10 - Issues Root Cause'
	lineageTag: 5fabf9d6-77bb-4df8-8bd6-5eb57c3c101c
	sourceLineageTag: [sch_TeamMate].[A10 - Issues Root Cause]

	measure FilterFlag =
			
			VAR _tbl =
			    FILTER(
			        ADDCOLUMNS(
			            GENERATE(
			                VALUES( 'A10 - Issues Root Cause'[Issues.MultiSelectCategory3]),
			                VALUES( A10_01[@RootCauseCategory] )
			            ),
			            "Flag",
			                IF(
			                    CONTAINSSTRING( 'A10 - Issues Root Cause'[Issues.MultiSelectCategory3], A10_01[@RootCauseCategory] ),
			                    1,
			                    0
			                )
			        ),
			        [Flag] = 1
			    )
			RETURN
			    IF( COUNTROWS( _tbl ), 1, 0 )
		formatString: 0
		lineageTag: 3136cfa2-a029-4ec5-92a5-dd176ce3df4a

		changedProperty = Name

