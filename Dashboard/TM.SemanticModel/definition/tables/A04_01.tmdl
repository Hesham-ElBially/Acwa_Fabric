table A04_01
	lineageTag: b77e0d08-cb66-44de-979c-11ff4f1b994c
	sourceLineageTag: [sch_TeamMate].[A04_01]

	measure A04_01OverduePercentage = SUM('A04_01'[No. of Overdue Observations]) / CALCULATE(SUM('A04_01'[No. of Open Observations]), ALLSELECTED('A04_01'[Issues.Category2]))
		lineageTag: c7bf8f4f-ccb1-46ab-8b02-e9c0e9702a60

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure A04_01_KPI_B_Status = ```
			SWITCH( 
			                        TRUE,
			                        (SELECTEDVALUE(A04_01[Issues.Category2]) = "High") && ('A04_01'[A04_01OverduePercentage] >=0.05), "01. KPI B Breach",
			                        (SELECTEDVALUE(A04_01[Issues.Category2]) = "Significant") && ('A04_01'[A04_01OverduePercentage] >=0.1), "01. KPI B Breach",
			                        (SELECTEDVALUE(A04_01[Issues.Category2]) = "Medium") && ('A04_01'[A04_01OverduePercentage] >=0.1), "01. KPI B Breach",
			                        "02. KPI B Non Breach"
			)
			```
		lineageTag: 983b10b2-5347-4acd-ae97-958eca835f3a

		changedProperty = Name

